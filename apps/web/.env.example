# ============================================
# VITE_YGO_API_BASE_URL — REQUIRED
# ============================================
# This variable MUST be defined for the app to communicate with the YGO backend.
# Without it, API calls will fail at runtime.
#
# DEVELOPMENT:
#   Use the Vite dev-server proxy path to avoid CORS issues.
#   The proxy is configured in vite.config.ts.
#
# PRODUCTION:
#   Use the full backend URL or your own CDN/reverse-proxy URL.
#   The value is baked into the client bundle at build time.

# Development (uses Vite proxy — no CORS)
VITE_YGO_API_BASE_URL=/ygo-api/v1

# Production (replace with your actual backend URL)
# VITE_YGO_API_BASE_URL=https://ygo-api-wrapper-177404616225.us-central1.run.app/api/v1
